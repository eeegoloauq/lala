{
    "compilerOptions": {
        "composite": true,
        "skipLibCheck": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowSyntheticDefaultImports": true,
        "outDir": "node_modules/.tmp/tsconfig.node",
        "emitDeclarationOnly": true,
        "allowImportingTsExtensions": true
    },
    "include": [
        "vite.config.ts",
        "scripts/*.ts"
    ]
}