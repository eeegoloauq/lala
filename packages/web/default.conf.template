# Rate limiting zone for API requests (defense-in-depth, Express has its own)
limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;
# A room list loads every new avatar at once, a chat every picture on its page; each URL
# is then cached for good.
limit_req_zone $binary_remote_addr zone=avatars:10m rate=30r/s;

server {
    listen 80;
    server_tokens off;

    # Take the client address from a reverse proxy on a private network, so per-IP rate
    # limits (here and in the API) apply to clients rather than to the proxy. Public
    # sources can't set it.
    set_real_ip_from  10.0.0.0/8;
    set_real_ip_from  172.16.0.0/12;
    set_real_ip_from  192.168.0.0/16;
    set_real_ip_from  127.0.0.0/8;
    set_real_ip_from  fc00::/7;
    real_ip_header    X-Forwarded-For;
    real_ip_recursive on;

    # HTTPS enforcement when behind a reverse proxy (Caddy/Traefik/nginx-proxy)
    if ($http_x_forwarded_proto = "http") {
        return 301 https://$host$request_uri;
    }

    # Security headers
    add_header X-Content-Type-Options    "nosniff"       always;
    add_header X-Frame-Options           "SAMEORIGIN"    always;
    add_header Referrer-Policy           "same-origin"   always;
    # CSP: connect-src origins configurable via CSP_CONNECT_SRC env var
    # Default: wss: ws: (allows any WebSocket). Tighten in .env for your domain.
    # script-src deliberately has no 'unsafe-inline': the Vite build emits no inline
    # scripts, and allowing them would gut CSP's XSS protection. 'wasm-unsafe-eval'
    # allows compiling WebAssembly (noise suppression, background blur), not eval.
    add_header Content-Security-Policy
        "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ${CSP_CONNECT_SRC}; media-src 'self' blob: data:; worker-src 'self' blob:; img-src 'self' data: blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self';"
        always;

    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;

        # Hashed assets get long cache (Vite generates unique filenames). No add_header
        # here: one would stop the server-level security headers from being inherited.
        location /assets/ {
            expires 1y;
        }
    }

    # SSE endpoints (people's room list, bots' invitations) — must NOT use
    # Connection: upgrade; need buffering disabled
    location ~ ^/api/(bot/)?events$ {
        limit_req          zone=api burst=20 nodelay;
        proxy_pass         http://api:3001;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-For   $remote_addr;
        proxy_set_header   Connection "";
        proxy_buffering    off;
        proxy_cache        off;
        proxy_read_timeout 86400s;
        proxy_hide_header  X-Powered-By;
        chunked_transfer_encoding on;
    }

    location /api/avatars/ {
        limit_req          zone=avatars burst=100 nodelay;
        proxy_pass         http://api:3001;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-For   $remote_addr;
        proxy_hide_header  X-Powered-By;
    }

    location /api/files/ {
        limit_req          zone=avatars burst=100 nodelay;
        proxy_pass         http://api:3001;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-For   $remote_addr;
        proxy_hide_header  X-Powered-By;
    }

    # Chat file uploads: the API refuses one over the server's limit (chatFiles.space or
    # chatFiles.maxFile) and reads the body as it arrives, so nginx neither limits nor buffers it.
    location ~ ^/api/chats/[^/]+/files$ {
        limit_req               zone=api burst=20 nodelay;
        client_max_body_size    0;
        proxy_request_buffering off;
        proxy_read_timeout      600s;
        proxy_send_timeout      600s;
        proxy_pass              http://api:3001;
        proxy_http_version      1.1;
        proxy_set_header        Host              $host;
        proxy_set_header        X-Forwarded-For   $remote_addr;
        proxy_hide_header       X-Powered-By;
    }

    location /api/ {
        limit_req          zone=api burst=20 nodelay;
        proxy_pass         http://api:3001;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-For   $remote_addr;
        proxy_cache_bypass $http_upgrade;
        proxy_hide_header  X-Powered-By;
    }
}
