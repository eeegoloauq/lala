# LiveKit Server Configuration
# Docs: https://docs.livekit.io/realtime/self-hosting/deployment/
#
# This is a TEMPLATE. The actual livekit.yaml is generated at container
# startup by docker-compose (sed substitution from environment variables).
# To run outside Docker, copy this file to livekit.yaml and replace the
# ${...} placeholders with real values.

port: 7880

rtc:
  # TCP fallback for clients behind strict firewalls
  tcp_port: 7881

  # UDP mux — all media through a single port (simplifies NAT/firewall)
  udp_port: 50000

  # Public IP or domain for WebRTC ICE candidates
  use_external_ip: false
  node_ip: ${NODE_IP}

  # Enable ICE lite for better NAT traversal
  use_ice_lite: true

  # Listen for media only on the container address Docker publishes the ports to
  # (filled in at startup). Outside Docker, put this server's own address here.
  ips:
    includes:
      - ${RTC_IP}/32

# Built-in TURN server — needed for clients behind strict NAT (Firefox, corporate networks)
# TURN/UDP on 3478 is sufficient; no HTTP proxy needed (NPM can't proxy TURN)
turn:
  enabled: true
  domain: ${LIVEKIT_DOMAIN}
  udp_port: 3478
  # TTL of the TURN credentials in seconds (server default: 300).
  # Since v1.12 credentials expire and are validated when a relay
  # allocation is created; expired ones are rejected (hard since v1.13.1).
  # ttl_seconds: 300
  # Since v1.12 TURN refuses to relay to restricted peer CIDRs (private,
  # loopback, link-local, multicast) by default. If node_ip above is a
  # private address (LAN-only deployment), allow it explicitly here,
  # otherwise clients that need TURN will fail to connect:
  # allow_restricted_peer_cidrs:
  #   - 10.0.0.0/8
  #   - 192.168.0.0/16

room:
  # Max participants per room
  max_participants: 10
  # Remove empty rooms after 5 minutes
  empty_timeout: 300
  # Disconnect clients after 30 seconds of no pong
  departure_timeout: 30

# API keys for authentication
keys:
  ${LIVEKIT_API_KEY}: ${LIVEKIT_API_SECRET}

# No redis: section. Redis lets several LiveKit servers share rooms; a single server keeps
# them in memory. With it, rooms survive a restart in Redis but stay assigned to the
# stopped process, so they can be neither joined nor deleted.

# Webhook — push room events to our API (internal Docker network, no external port needed)
webhook:
  api_key: ${LIVEKIT_API_KEY}
  urls:
    - http://api:3001/api/webhook

# Logging
logging:
  level: info
  json: false
