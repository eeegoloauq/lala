#!/usr/bin/env bash
# Pull-based deploy. CI publishes the images and nothing more; this host decides
# when to move, so the build machine holds no key to it.
#
# A release that does not come up is rolled back and its commit remembered:
# without that the timer would retry the same broken release on every run for as
# long as it is at the tip of main.
set -euo pipefail

STATE=/var/lib/lala-pull
SKIP=$STATE/rejected
DEADLINE=120   # seconds to come up before this counts as a bad release

exec 9>"$STATE/lock"
flock -n 9 || { echo "$(date -Is) another run is in progress"; exit 0; }

cd /opt/lala
REGISTRY=$(grep -E '^LALA_REGISTRY=' .env | cut -d= -f2-)

is_sha() { [[ $1 =~ ^[0-9a-f]{40}$ ]]; }

# Read off the container rather than out of a file, so a run that dies half way
# leaves nothing to repair. A host started from a moving tag (latest, edge) has no
# commit there; the checkout is the next best answer.
running() {
  local tag
  tag=$(docker inspect -f '{{.Config.Image}}' lala-api 2>/dev/null | sed 's/.*://') || true
  if is_sha "$tag"; then echo "$tag"; else git rev-parse HEAD; fi
}

alive() {
  local until=$((SECONDS + DEADLINE))
  while [ $SECONDS -lt $until ]; do
    curl -fsS -o /dev/null --max-time 5 http://127.0.0.1:3000/api/health && return 0
    sleep 5
  done
  return 1
}

# Deploy and rollback are the same move: the checkout (compose file, LiveKit
# template) and the images go to one commit together. The tag is persisted so a
# reboot or a manual `docker compose up` stays on it. Chained with && because
# callers use it as a condition, where errexit does not apply.
deploy_to() {
  git -c advice.detachedHead=false checkout --quiet --detach "$1" &&
    sed -i "s/^LALA_TAG=.*/LALA_TAG=$1/" .env &&
    LALA_TAG="$1" docker compose up -d
}

have=$(running)
git fetch --quiet origin main
want=$(git rev-parse origin/main)
[ "$want" = "$have" ] && exit 0
[ -f "$SKIP" ] && [ "$(cat "$SKIP")" = "$want" ] && exit 0

# The image is built after the commit lands, so a fresh commit usually has none
# yet. That is not an error — wait for the next tick.
if ! docker pull -q "$REGISTRY/lala-api:$want" >/dev/null 2>&1 \
   || ! docker pull -q "$REGISTRY/lala-web:$want" >/dev/null 2>&1; then
  echo "$(date -Is) nothing published for ${want:0:12} yet"
  exit 0
fi

echo "$(date -Is) moving ${have:0:12} -> ${want:0:12}"
if deploy_to "$want" && alive; then
  echo "$(date -Is) ${want:0:12} is up"
  rm -f "$SKIP"
  exit 0
fi

echo "$(date -Is) ${want:0:12} did not come up, going back to ${have:0:12}" >&2
echo "$want" > "$SKIP"
deploy_to "$have"
if alive; then
  echo "$(date -Is) back on ${have:0:12}" >&2
else
  echo "$(date -Is) ${have:0:12} did not come back either" >&2
fi
exit 1
